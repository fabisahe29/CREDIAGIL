{
  "compilerOptions": {
    "strict": true,
    "noEmit": true,
    "erasableSyntaxOnly": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "module": "nodenext",
    "target": "es2023",
    "types": ["node"],
    "skipLibCheck": true
  },
  "include": [
    ".claude/hooks/**/*.ts",
    ".claude/revision/**/*.ts",
    ".claude/agents/**/*.ts",
    ".claude/skills/**/*.ts",
    "scripts/**/*.ts",
    "src/**/*.ts"
  ]
}
