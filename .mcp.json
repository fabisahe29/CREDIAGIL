{
  "mcpServers": {
    "github": {
      "type": "http",
      "url": "https://api.githubcopilot.com/mcp/",
      "headers": {
        "Authorization": "Bearer ${GIT_HUB}",
        "X-MCP-Toolsets": "context,repos,issues,pull_requests,projects"
      }
    },
    "crediagil-core": {
      "type": "stdio",
      "command": "node",
      "args": ["${CLAUDE_PROJECT_DIR:-.}/src/mcp/principal.ts"]
    }
  }
}
